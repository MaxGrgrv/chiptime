{
  "name": "chiptime",
  "version": "0.6.0",
  "description": "Recovery-grade FIT file processing: parse anything, lose nothing silently, explain everything.",
  "license": "MIT",
  "author": "Maxim Grigoryev",
  "homepage": "https://maxgrgrv.github.io/chiptime/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxGrgrv/chiptime.git",
    "directory": "js"
  },
  "bugs": "https://github.com/MaxGrgrv/chiptime/issues",
  "keywords": [
    "fit",
    "garmin",
    "fitness",
    "activity",
    "parser",
    "recovery",
    "repair",
    "cycling",
    "running"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./canonical": {
      "types": "./dist/esm/canonical.d.ts",
      "import": "./dist/esm/canonical.js",
      "require": "./dist/cjs/canonical.js"
    },
    "./errors": {
      "types": "./dist/esm/errors.d.ts",
      "import": "./dist/esm/errors.js",
      "require": "./dist/cjs/errors.js"
    },
    "./frames": {
      "types": "./dist/esm/frames.d.ts",
      "import": "./dist/esm/frames.js",
      "require": "./dist/cjs/frames.js"
    },
    "./message": {
      "types": "./dist/esm/message.d.ts",
      "import": "./dist/esm/message.js",
      "require": "./dist/cjs/message.js"
    },
    "./profile": {
      "types": "./dist/esm/profile/index.d.ts",
      "import": "./dist/esm/profile/index.js",
      "require": "./dist/cjs/profile/index.js"
    },
    "./package.json": "./package.json",
    "./decode": {
      "types": "./dist/esm/decode.d.ts",
      "import": "./dist/esm/decode.js",
      "require": "./dist/cjs/decode.js"
    },
    "./intake": {
      "types": "./dist/esm/intake.d.ts",
      "import": "./dist/esm/intake.js",
      "require": "./dist/cjs/intake.js"
    },
    "./inflate": {
      "types": "./dist/esm/inflate.d.ts",
      "import": "./dist/esm/inflate.js",
      "require": "./dist/cjs/inflate.js"
    },
    "./result": {
      "types": "./dist/esm/result.d.ts",
      "import": "./dist/esm/result.js",
      "require": "./dist/cjs/result.js"
    },
    "./sha256": {
      "types": "./dist/esm/sha256.d.ts",
      "import": "./dist/esm/sha256.js",
      "require": "./dist/cjs/sha256.js"
    },
    "./cli": {
      "types": "./dist/esm/cli.d.ts",
      "import": "./dist/esm/cli.js",
      "require": "./dist/cjs/cli.js"
    },
    "./encode": {
      "types": "./dist/esm/encode.d.ts",
      "import": "./dist/esm/encode.js",
      "require": "./dist/cjs/encode.js"
    },
    "./repair": {
      "types": "./dist/esm/repair.d.ts",
      "import": "./dist/esm/repair.js",
      "require": "./dist/cjs/repair.js"
    },
    "./validate": {
      "types": "./dist/esm/validate.d.ts",
      "import": "./dist/esm/validate.js",
      "require": "./dist/cjs/validate.js"
    },
    "./metrics": {
      "types": "./dist/esm/metrics/index.d.ts",
      "import": "./dist/esm/metrics/index.js",
      "require": "./dist/cjs/metrics/index.js"
    },
    "./edit": {
      "types": "./dist/esm/edit.d.ts",
      "import": "./dist/esm/edit.js",
      "require": "./dist/cjs/edit.js"
    },
    "./trim": {
      "types": "./dist/esm/trim.d.ts",
      "import": "./dist/esm/trim.js",
      "require": "./dist/cjs/trim.js"
    }
  },
  "files": ["dist", "bin", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "parity": {
    "python": "0.6.0",
    "note": "npm 0.N.0 mirrors the feature surface of PyPI 0.N.0 (ADR-0009 §9)."
  },
  "//": "Contract: the core has ZERO runtime dependencies. Any addition requires an ADR (ADR-0009 §7).",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && node scripts/finish-build.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "guards": "node scripts/guards.mjs",
    "smoke": "bash scripts/smoke.sh",
    "check": "npm run lint && npm run typecheck && npm run guards && npm test",
    "determinism": "npm run build && node scripts/determinism.mjs"
  },
  "bin": {
    "chiptime": "./bin/chiptime.mjs"
  }
}
