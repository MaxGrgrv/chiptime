#!/bin/sh
# chiptime pre-push gate: what CI checks, checked BEFORE the push exists.
# Installed via: git config core.hooksPath .githooks   (documented in CLAUDE.md)
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push gate: ruff (full scope)"
(cd python && uv run ruff check . ../corpus/tools ../scripts)
echo "pre-push gate: ruff format"
(cd python && uv run ruff format --check . ../corpus/tools ../scripts)
echo "pre-push gate: mypy"
(cd python && uv run mypy)
echo "pre-push gate: corpus integrity"
uv run --project python python corpus/tools/gen_all.py > /dev/null
echo "pre-push gate: docs build (strict)"
uv run --project python --group docs mkdocs build --quiet
echo "pre-push gate: pytest"
(cd python && uv run pytest -q)

# The repo is bilingual from F31. Skipped when js/node_modules is absent, so a
# Python-only clone can still push — CI runs these unconditionally either way.
if [ -d js/node_modules ]; then
  echo "pre-push gate: parity vectors (regenerate + diff)"
  uv run --project python python scripts/gen_parity_vectors.py > /dev/null
  git diff --exit-code -- js/test/vectors
  echo "pre-push gate: profile tables (regenerate + diff + value parity)"
  uv run --project python python scripts/gen_profile_ts.py > /dev/null
  git diff --exit-code -- js/src/profile/generated.ts
  uv run --project python python scripts/check_profile_parity.py
  echo "pre-push gate: js lint + types + guards + tests"
  (cd js && npm run check)
  echo "pre-push gate: js determinism (cross-process, cross-language)"
  # Build once, then run the checker twice: comparing `npm run determinism` output
  # would compare build chatter, not hashes.
  (cd js && npm run build > /dev/null)
  (cd js && node scripts/determinism.mjs > /tmp/chiptime-det1)
  (cd js && node scripts/determinism.mjs > /tmp/chiptime-det2)
  diff /tmp/chiptime-det1 /tmp/chiptime-det2 > /dev/null || {
    echo "pre-push gate: canonical output differs between processes" >&2
    exit 1
  }
  cat /tmp/chiptime-det1
else
  echo "pre-push gate: js/ skipped (no node_modules — run 'npm install' in js/)"
fi

echo "pre-push gate: all green"
